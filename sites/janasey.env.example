# Janasey — copy to sites/janasey.env and fill secrets.
# bake: make build-windows-janasey
# Create a Cloudflare Pages Direct Upload project named "janasey" before first publish.
PROJECTWHY_DEFAULT_DEPLOY_PROVIDER=cloudflare
PROJECTWHY_PROJECT_FOLDER=JanaseyWebsite

PROJECTWHY_CF_API_TOKEN=
PROJECTWHY_CF_ACCOUNT_ID=
PROJECTWHY_CF_PROJECT_NAME=janasey
